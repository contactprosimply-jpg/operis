{
  "name": "operis",
  "version": "0.1.2",
  "description": "Operis — Gestion des appels d'offres BTP",
  "author": "Nikodex",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:icon": "node scripts/generate-icon.mjs",
    "desktop": "electron .",
    "desktop:build": "npm run desktop:icon && electron-builder --win --x64",
    "desktop:release": "node scripts/build-desktop-release.mjs",
    "desktop:upload": "node scripts/upload-desktop-release.mjs",
    "sync": "npx tsx scripts/sync-mail.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "fr.nikodex.operis",
    "productName": "Operis",
    "copyright": "Nikodex",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "publish": {
      "provider": "generic",
      "url": "https://operis-pro.com/api/desktop/update",
      "channel": "latest"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "shortcutName": "Operis",
      "artifactName": "Operis-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Operis-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-virtual": "^3.14.4",
    "autoprefixer": "^10.5.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.3.2",
    "jspdf": "^4.2.1",
    "mailparser": "^3.9.8",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.1",
    "tailwindcss": "^3.4.19",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "sharp": "^0.33.5",
    "to-ico": "^1.1.5",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
