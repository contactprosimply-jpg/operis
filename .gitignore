# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist-desktop

# Installateurs Windows + manifeste de mise à jour (trop volumineux pour git —
# hébergés sur Supabase Storage, voir scripts/upload-desktop-release.mjs)
/public/downloads/*.exe
/public/downloads/*.blockmap
/public/downloads/latest.yml
!/public/downloads/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

supabase/.temp/
